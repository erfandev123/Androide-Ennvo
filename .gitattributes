# Normalise the line endings so the GitHub Actions runners — which run on
# Ubuntu — always see a LF script, and so the Windows checkout keeps CRLF
# for the files that need it.

* text=auto eol=lf

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.dart text eol=lf
*.json text eol=lf
*.md text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.pro text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.mp3 binary
*.mp4 binary
*.jks binary
*.keystore binary
