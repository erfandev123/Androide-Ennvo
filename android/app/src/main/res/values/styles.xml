<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The theme of the Android window while the process starts, with the
         OS dark mode off.

         The window is black in both modes: the Flutter splash that follows
         paints the same black, so the app opens on one uninterrupted
         screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The theme of the window once the process is up: the colour the
         Flutter UI is drawn over. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
