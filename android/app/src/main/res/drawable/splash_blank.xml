<?xml version="1.0" encoding="utf-8"?>
<!-- An empty icon for the Android 12 splash screen.

     Android 12 always draws an icon in the middle of its splash screen. The
     Ennvo logo is drawn by the Flutter splash that follows, so the system
     icon has to stay invisible - otherwise the mark is seen twice. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
